# =============================================================================
# VARIABLES DE ENTORNO — SERVIDOR DE CONTROL Y RECUPERACIÓN (DOCENTE)
# Copiar este archivo a '.env' y ajustar según la red local y Proxmox
# =============================================================================

FLASK_APP=server.wsgi:app
SECRET_KEY=generar-clave-secreta-aleatoria-docente

# Base de datos SQLite (almacenamiento local ligero, sin servidor MySQL adicional)
DATABASE_URL=sqlite:///control_equipos.sqlite3

# Token de enrolamiento inicial para vincular PCs de estudiantes al aula
AGENT_ENROLLMENT_TOKEN=token-de-enrolamiento-secreto-aula-2026

# Tiempo sin heartbeat para considerar a un equipo 'Desconectado' (segundos)
HEARTBEAT_TIMEOUT_SECONDS=30

COOKIE_SECURE=false

# =============================================================================
# CONEXIÓN CON LA API REST DE PROXMOX VE (Máquina física en red local)
# =============================================================================
PROXMOX_HOST=192.168.1.50
PROXMOX_USER=root@pam
# Opción A (Recomendada): Autenticación mediante API Token de Proxmox
PROXMOX_TOKEN_ID=control-aula
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# Opción B (Alternativa): Contraseña de usuario Proxmox (si no se usa token)
PROXMOX_PASSWORD=

# Configuración del hipervisor
PROXMOX_NODE=pve
PROXMOX_SNAPSHOT=estado_limpio
PROXMOX_VERIFY_SSL=false
